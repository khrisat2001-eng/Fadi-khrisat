# Copy to .env (never commit .env). These are app settings, not exchange keys:
# exchange API keys are entered only through the web wizard.

# 32 random bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CREDENTIAL_MASTER_KEY=
# Long random string used to sign in to the web app.
APP_ACCESS_TOKEN=
DATABASE_PATH=data/portal.db
HEALTH_CHECK_INTERVAL_SECONDS=300
# Public IP(s) of the server, shown in the wizard so you can restrict your exchange keys to them.
SERVER_EGRESS_IPS=
# Set to false only for local development over plain http.
SECURE_COOKIES=true

# Optional: AI news classification. Without a key, keyword rules are used.
ANTHROPIC_API_KEY=
# NEWS_CLASSIFIER_MODEL=claude-opus-5-5
# NEWS_CLASSIFIER_EFFORT=low
# Some sources (e.g. the SEC) ask automated readers to identify themselves with contact details.
NEWS_USER_AGENT="FadiTradingApp/0.1 (contact: you@example.com)"
